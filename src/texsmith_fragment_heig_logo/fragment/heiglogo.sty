\newcommand\heiglogo@draw[2]{%
    \begin{tikzpicture}[x=0.7pt,y=0.7pt,scale=\heiglogo@scale,inner sep=0,outer sep=0]
        \ifheiglogo@hastexttitle
            \pgfmathsetmacro\heiglogo@bbright
                {\heiglogo@textanchorx+\heiglogo@textwidth/(0.7*\heiglogo@scale)}%
        \else
            \ifheiglogo@hastextsubtitle
                \pgfmathsetmacro\heiglogo@bbright
                    {\heiglogo@textanchorx+\heiglogo@textwidth/(0.7*\heiglogo@scale)}%
            \else
                \let\heiglogo@bbright\heiglogo@nativewidth
            \fi
        \fi
        \useasboundingbox (0,0) rectangle (\heiglogo@bbright,\heiglogo@nativeheight);
        \csname heiglogo@draw@\heiglogo@year\endcsname

        \ifheiglogo@hastexttitle
            \fill[\heiglogo@curcolor]
            (\heiglogo@separatorx,0)--(\heiglogo@separatorx,\heiglogo@nativeheight)
            --(\heiglogo@separatorx+1,\heiglogo@nativeheight)--(\heiglogo@separatorx+1,0)--cycle;
        \else
            \ifheiglogo@hastextsubtitle
                \fill[\heiglogo@curcolor]
                (\heiglogo@separatorx,0)--(\heiglogo@separatorx,\heiglogo@nativeheight)
                --(\heiglogo@separatorx+1,\heiglogo@nativeheight)--(\heiglogo@separatorx+1,0)--cycle;
            \fi
        \fi

        \ifheiglogo@hastexttitle
        \node[anchor=north west,inner sep=0,outer sep=0] at (\heiglogo@textanchorx,\heiglogo@nativeheight)
        {%
            \begingroup
            \color{\heiglogo@curcolor}\heiglogo@ensurefont\heiglogoFont\bfseries
            \setlength{\parskip}{0pt}%
            \lineskiplimit=0pt\lineskip=0pt%
            \fontsize{\heiglogo@title@size}{\heiglogo@title@baseline}\selectfont
            \parbox[t][\heiglogo@height][t]{\heiglogo@textwidth}{%
                \raggedright\MakeUppercase{#1}%
            }%
            \endgroup
        };
        \fi
        \ifheiglogo@hastextsubtitle
        \node[anchor=south west,inner sep=0,outer sep=0] at (\heiglogo@textanchorx,2)
        {%
            \begingroup
            \color{\heiglogo@curcolor}\heiglogo@ensurefont\heiglogoFont
            \setlength{\parskip}{0pt}%
            \lineskiplimit=0pt\lineskip=0pt%
            \fontsize{\heiglogo@title@size}{\heiglogo@title@baseline}\selectfont
            \parbox[b][\heiglogo@height][b]{\heiglogo@textwidth}{%
                \raggedright #2%
            }%
            \endgroup
        };
        \fi
    \end{tikzpicture}%
}

\newcommand\heiglogo@relative[2]{%
    \begingroup
    \pgfmathsetmacro{\heiglogo@scale}{\heiglogo@height/\heiglogo@scaleref}%
    \heiglogo@draw{#1}{#2}%
    \endgroup
}

\newcommand\heiglogo@absolute[2]{%
    \begin{tikzpicture}[remember picture,overlay,inner sep=0,outer sep=0,baseline]
        \begingroup
        \pgfmathsetmacro{\heiglogo@scale}{\heiglogo@height/\heiglogo@scaleref}%
        \ifdim\heiglogo@right>-1pt
            \node[anchor=north east,inner sep=0,outer sep=0] at
            ([xshift=-\heiglogo@right,yshift=-\heiglogo@top] current page.north east)
            {\heiglogo@draw{#1}{#2}};
        \else
            \node[anchor=north west,inner sep=0,outer sep=0] at
            ([xshift=\heiglogo@left,yshift=-\heiglogo@top] current page.north west)
            {\heiglogo@draw{#1}{#2}};
        \fi
        \endgroup
    \end{tikzpicture}%
    \vspace*{-\baselineskip}%
}

